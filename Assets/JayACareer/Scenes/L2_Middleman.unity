  steps:
  - text: Talk to Dr. Hale before tonight's order
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Briefing
    completeWhen: []
    marker: {fileID: 2338187285961070044}
  - text: Seal Luka's order at the preparation bench
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Preparation
    completeWhen: []
    marker: {fileID: 3032624231172731779}
  - text: Carry the carton to the counter. Luka is waiting
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Delivery
    completeWhen: []
    marker: {fileID: 1368642633}
  - text: Deal with Luka. It's your call
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Negotiation
    completeWhen: []
    marker: {fileID: 7299014544402904185}
  - text: Check the phone Luka left on the counter
    showWhen:
    - type: 0
      key: lukaDealt
      intValue: 0
      textValue: 
    completeWhen:
    - type: 0
      key: phoneNoteFound
      intValue: 0
      textValue: 
    marker: {fileID: 2056227748}
  - text: Go back to the lab and tell Dr. Hale how it went
    showWhen:
    - type: 0
      key: lukaDealt
      intValue: 0
      textValue: 
    completeWhen:
    - type: 0
      key: haleReacted
      intValue: 0
      textValue: 
    marker: {fileID: 2338187285961070044}
  - text: Put the unsold carton back on the lab's return shelf
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Return
    completeWhen: []
    marker: {fileID: 779032004}
  - text: Clean the preparation bench at the sink
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Cleaning
    completeWhen: []
    marker: {fileID: 5368343513756144587}
  - text: Go home and sleep. The day is over
    showWhen:
    - type: 4
      key: loop.stage
      intValue: 0
      textValue: Sleep
    completeWhen: []
    marker: {fileID: 8054948365049432493}
