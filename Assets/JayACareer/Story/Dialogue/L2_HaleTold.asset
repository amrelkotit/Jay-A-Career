  id: L2_HaleTold
  lines:
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Luka got a message on his phone. From someone who signs as "P."
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: ...Thank you for telling me. Don't say that letter inside my lab again.
      Clean the bench. Go home.
    conditions: []
