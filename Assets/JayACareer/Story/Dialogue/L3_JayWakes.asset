  m_Script: {fileID: 11500000, guid: f670f815c51170442b47b92f4a03f3f7, type: 3}
  m_Name: L3_JayWakes
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L3_JayWakes
  lines:
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Hale didn't call all day. Now it's midnight, the rent is due at dawn, and
      his lab is dark.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: And that car has been parked out there for an hour.
    conditions: []
  choices: []
  onComplete: []
  loopActionOnComplete: 0
  playOnce: 1
