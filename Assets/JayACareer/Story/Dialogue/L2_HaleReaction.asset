  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f670f815c51170442b47b92f4a03f3f7, type: 3}
  m_Name: L2_HaleReaction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L2_HaleReaction
  lines:
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: He paid what he offered? Fine. Clean. Forgettable. Good.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: accepted
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Forgettable is how men like me stay alive out here.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: accepted
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Two hundred and fifty.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: pushed
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: You made us visible, Jay. Do you understand what that means out here? It
      means somebody writes our names down.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: pushed
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: You sent Luka away.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: refused
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: ...That took more nerve than you know. More than I had at your age.
    conditions:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: refused
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Clean up. Go home. Tomorrow will be... different.
    conditions:
    - type: 1
      key: phoneNoteFound
      intValue: 0
      textValue: 
  choices:
  - text: Tell Hale about the message from "P." (Trust +1)
    conditions:
    - type: 0
      key: phoneNoteFound
      intValue: 0
      textValue: 
    effects:
    - type: 2
      key: trust
      intValue: 1
      textValue: 
    - type: 0
      key: toldHale
      intValue: 0
      textValue: 
    loopAction: 0
    payment: 0
    next: {fileID: 11400000, guid: bf8d12153375ffe4ca384cf5fe4e3f58, type: 2}
  - text: "Keep it to yourself. (Trust \u22121)"
    conditions:
    - type: 0
      key: phoneNoteFound
      intValue: 0
      textValue: 
    effects:
    - type: 2
