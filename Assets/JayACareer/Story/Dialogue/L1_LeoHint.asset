  id: L1_LeoHint
  lines:
  - speaker: {fileID: 11400000, guid: 4ece559b3152d1045b879712b640ae72, type: 2}
    text: Who else? Man, I don't... look. Everybody knows Hale's stuff is the only
      stuff Paul's people don't touch.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Who's Paul?
    conditions: []
  - speaker: {fileID: 11400000, guid: 4ece559b3152d1045b879712b640ae72, type: 2}
    text: Nobody. Forget I said it. Can we, uh, can we just do this?
    conditions: []
  choices:
  - text: Count the money and hand over the carton.
    conditions: []
    effects:
    - type: 0
      key: leoPaid
      intValue: 0
      textValue: 
    loopAction: 2
    payment: 100
    next: {fileID: 11400000, guid: 6ebd5ed141d169f4ca14693675ade2cb, type: 2}
  onComplete:
  - type: 5
    key: paul
    intValue: 0
    textValue: 'A name: Paul|Leo let a name slip: Paul. Whoever he is, "Paul''s people"
      leave Hale''s orders alone. Leo looked scared just saying it.'
  loopActionOnComplete: 0
