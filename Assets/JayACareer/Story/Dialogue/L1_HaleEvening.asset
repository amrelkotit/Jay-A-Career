  m_Name: L1_HaleEvening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L1_HaleEvening
  lines:
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Clean. Good. Don't go home yet, Jay. The second order is tonight.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Who's buying?
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Someone I'd rather not sell to. Come back when the street lights come on.
      We'll talk before he gets here.
    conditions: []
