  m_Name: L2_LukaDeal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L2_LukaDeal
  lines:
  - speaker: {fileID: 11400000, guid: bdc6da8f8fad4c342b2ff70dc0a53dcd, type: 2}
    text: So you're the old man's new boy. Look at you. Clean shoes. That won't last.
    conditions: []
  - speaker: {fileID: 11400000, guid: bdc6da8f8fad4c342b2ff70dc0a53dcd, type: 2}
    text: Here's how this goes. I give you a hundred and fifty for that carton. You
      say thank you.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Hale said you'd say that.
    conditions: []
  - speaker: {fileID: 11400000, guid: bdc6da8f8fad4c342b2ff70dc0a53dcd, type: 2}
    text: Hale says a lot of things to people who work for him. So? We doing this?
    conditions: []
  choices:
  - text: Accept $150.
    conditions: []
    effects:
    - type: 4
      key: lukaDeal
      intValue: 0
      textValue: accepted
    - type: 2
