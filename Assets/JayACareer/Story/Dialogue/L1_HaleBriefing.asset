MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f670f815c51170442b47b92f4a03f3f7, type: 3}
  m_Name: L1_HaleBriefing
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L1_HaleBriefing
  lines:
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: You're the Jay who called. You're early. Good. Early is rare in this town.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: You said there was work. I need it. Like, yesterday.
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: The work is simple. You seal the order at the preparation bench, carry
      it across the road to the counter, and take the money.
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Then you come back, clean the bench, and go home. You do not open the cartons.
      You do not talk about the cartons.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: What's in them?
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: An order. That is all it ever needs to be.
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Today's buyer is Leo. He is nervous, he talks too much, and he pays. Don't
      keep him waiting.
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: And Jay... my desk is not part of the job.
    conditions: []
  choices: []
  onComplete:
  - type: 0
    key: briefingDone
    intValue: 0
    textValue: 
  loopActionOnComplete: 1
  playOnce: 1
