  m_Script: {fileID: 11500000, guid: f670f815c51170442b47b92f4a03f3f7, type: 3}
  m_Name: L1_LeoDeal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L1_LeoDeal
  lines:
  - speaker: {fileID: 11400000, guid: 4ece559b3152d1045b879712b640ae72, type: 2}
    text: Hey. Hey, you're the new guy? Hale said someone new. Cool. Cool cool.
    conditions: []
  - speaker: {fileID: 11400000, guid: 4ece559b3152d1045b879712b640ae72, type: 2}
    text: Is that mine? Sealed and everything. Hale's stuff is always sealed. That's
      why people trust it.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: A hundred, right? That's what he said.
    conditions: []
  - speaker: {fileID: 11400000, guid: 4ece559b3152d1045b879712b640ae72, type: 2}
    text: Yeah, yeah, a hundred, it's all here. Small bills, sorry. It's how they
      pay me.
    conditions: []
  choices:
  - text: Count the money and hand over the carton.
    conditions: []
    effects:
    - type: 0
      key: leoPaid
      intValue: 0
      textValue: 
    loopAction: 2
    payment: 100
    next: {fileID: 11400000, guid: 6ebd5ed141d169f4ca14693675ade2cb, type: 2}
  - text: '"Who else buys from Hale?"'
    conditions: []
    effects: []
    loopAction: 0
    payment: 0
    next: {fileID: 11400000, guid: cc892cf7dad42dd48840a2649668c1d4, type: 2}
