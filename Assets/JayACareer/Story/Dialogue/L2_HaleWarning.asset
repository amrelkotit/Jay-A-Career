  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f670f815c51170442b47b92f4a03f3f7, type: 3}
  m_Name: L2_HaleWarning
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  id: L2_HaleWarning
  lines:
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: 'Before you seal anything: tonight is different.'
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Tonight's buyer is Luka. Luka is not a customer, Jay. Luka collects for
      someone else.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: Collects for who?
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: For people who notice things. He'll offer you a price. He'll expect you
      to argue, and he'll expect you to lose.
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Take his price, push for more, or send him away. It's your counter tonight.
      I want to see what you do with it.
    conditions: []
  - speaker: {fileID: 11400000, guid: 37fb9708d40dec141b361114c996e24e, type: 2}
    text: And if I get it wrong?
    conditions: []
  - speaker: {fileID: 11400000, guid: b4a5171808e189648a6c629a843d67e0, type: 2}
    text: Then we both find out what kind of man I hired.
    conditions: []
  choices: []
  onComplete:
  - type: 0
    key: lukaWarned
    intValue: 0
    textValue: 
  loopActionOnComplete: 1
  playOnce: 1
